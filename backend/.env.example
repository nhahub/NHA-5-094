# ================================================================
# VerifiaAI — Environment Configuration (.env.example)
# Copy this file to .env and fill in your actual values.
# ================================================================

# -----------------------------------------------------------------
# Application
# -----------------------------------------------------------------
APP_NAME=VerifiaAI
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000
# Local Vite development origins; production must use exact HTTPS origins.
BACKEND_CORS_ORIGINS='["http://localhost:5173","http://127.0.0.1:5173"]'
# Production defaults to denying model calls. Opt in only after reviewing the
# vendor, endpoint origin, model, terms, and data classes. Routes pin all three.
# EXTERNAL_MODEL_DATA_POLICY=allowlist
# EXTERNAL_MODEL_ALLOWED_ROUTES='["groq:qwen/qwen3.8-27b|https://api.groq.com"]'
# API_DOCS_ENABLED defaults on locally and off in production.
# ALLOW_UNSCANNED_UPLOADS defaults on locally and off in production.

# -----------------------------------------------------------------
# Security
# -----------------------------------------------------------------
# Local-only placeholder. Production must use a unique random value of 32+ bytes.
SECRET_KEY=change_this_to_a_long_random_secret_key_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# -----------------------------------------------------------------
# PostgreSQL + pgvector
# -----------------------------------------------------------------
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=verifia_db
POSTGRES_USER=verifia_user
POSTGRES_PASSWORD=verifia_password
DATABASE_URL=postgresql+psycopg2://verifia_user:verifia_password@localhost:5432/verifia_db
ASYNC_DATABASE_URL=postgresql+asyncpg://verifia_user:verifia_password@localhost:5432/verifia_db

# -----------------------------------------------------------------
# Redis
# -----------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# -----------------------------------------------------------------
# Storage
# -----------------------------------------------------------------
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./data/storage
DOCUMENT_MAX_FILE_SIZE_BYTES=20971520
# Maximum full HTTP request body including multipart overhead (22 MiB)
REQUEST_MAX_BODY_SIZE_BYTES=23068672

# -----------------------------------------------------------------
# AI Models — LLM Gateway
# -----------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_DOCUMENT_MODEL=gemini-3.8-flash
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta/models
GEMINI_REQUEST_TIMEOUT_SECONDS=120
GEMINI_MAX_RETRIES=3
GEMINI_RETRY_BASE_SECONDS=1
# Groq Document Agent option. Put your preferred key first; fallbacks are tried in order.
# Keys only increase aggregate quota when issued under independently limited projects/orgs.
GROQ_API_KEY=
GROQ_API_KEY_FALLBACK_1=
GROQ_API_KEY_FALLBACK_2=
GROQ_DOCUMENT_MODEL=qwen/qwen3.8-27b
GROQ_API_BASE_URL=https://api.groq.com/openai/v1/chat/completions
GROQ_REQUEST_TIMEOUT_SECONDS=120
GROQ_MAX_RETRIES=2
GROQ_RETRY_BASE_SECONDS=1
# Additional providers used by the per-agent baseline routing below.
LLM7_API_KEY=
LLM7_API_BASE_URL=https://api.llm7.io/v1/chat/completions
LLM7_DOCUMENT_MODEL=gpt-oss:20b
KILO_API_KEY=
KILO_API_BASE_URL=https://api.kilo.ai/api/gateway/chat/completions
KILO_DOCUMENT_MODEL=dots-studio/dots-3-note-preview:free
# Agent-specific baseline routing; see root .env.example for provider/key setup.
DOCUMENT_MODEL_PROVIDER=llm7
DOCUMENT_MODEL=gpt-oss:20b
VERIFICATION_MODEL_PROVIDER=groq
VERIFICATION_MODEL=qwen/qwen3.8-27b
WORKFLOW_MODEL_PROVIDER=kilo
WORKFLOW_MODEL=dots-studio/dots-3-note-preview:free
SUPERVISOR_MODEL_PROVIDER=groq
SUPERVISOR_MODEL=qwen/qwen3.8-27b
CASE_ORCHESTRATION_ENABLED=true
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL_DOCUMENT=llama3.2
OLLAMA_MODEL_VERIFICATION=llama3.2
OLLAMA_MODEL_WORKFLOW=llama3.2
OLLAMA_REQUEST_TIMEOUT_SECONDS=120

# -----------------------------------------------------------------
# Phase 9 — Knowledge / RAG — Embedding Model (BAAI/bge-m3)
# -----------------------------------------------------------------

# Cloudflare Workers AI API (BGE-M3)
EMBEDDING_PROVIDER=cloudflare
EMBEDDING_MODEL_NAME=@cf/baai/bge-m3
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_AI_BASE_URL=https://api.cloudflare.com/client/v4

# Optional legacy Hugging Face provider credentials (only used when
# EMBEDDING_PROVIDER=huggingface_api).
HUGGINGFACE_HUB_TOKEN=

# Device for local mode only ("cpu" or "cuda")
EMBEDDING_DEVICE=cpu

# -----------------------------------------------------------------
# OCR
# -----------------------------------------------------------------
OCR_ENGINE=tesseract
TESSERACT_CMD=
OCR_LANGUAGE=eng
OCR_TIMEOUT_SECONDS=30
OCR_DPI=220

# -----------------------------------------------------------------
# Observability
# -----------------------------------------------------------------
LOG_LEVEL=INFO
ENABLE_AUDIT_LOG=true
