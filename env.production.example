# Copy to .env.production on the production host; replace every placeholder.
# Keep the resulting file out of source control and restrict its file permissions.
APP_ENV=production
DEBUG=false
SECRET_KEY=replace_me_with_a_unique_random_value_of_48_bytes_or_more
BACKEND_CORS_ORIGINS='["https://app.example.com"]'
API_DOCS_ENABLED=false
ALLOW_UNSCANNED_UPLOADS=false
EXTERNAL_MODEL_DATA_POLICY=deny

# Provision PostgreSQL and Redis as private managed services before deployment.
# Use the same URL-safe database credentials and database name in both PostgreSQL URLs.
DATABASE_URL=postgresql+psycopg2://verifia_app:replace_me_with_a_unique_url_safe_database_password@postgres.example.com:5432/verifia_db
ASYNC_DATABASE_URL=postgresql+asyncpg://verifia_app:replace_me_with_a_unique_url_safe_database_password@postgres.example.com:5432/verifia_db
REDIS_URL=rediss://:replace_me_with_a_unique_redis_password@redis.example.com:6380/0

# The host TLS reverse proxy forwards to this loopback-only frontend port.
FRONTEND_PORT=8080

# Upload limits: keep the request cap aligned with frontend/nginx.conf (22 MiB).
DOCUMENT_MAX_FILE_SIZE_BYTES=20971520
REQUEST_MAX_BODY_SIZE_BYTES=23068672
STORAGE_LOCAL_PATH=./data/storage

# Provider credentials are optional while EXTERNAL_MODEL_DATA_POLICY=deny.
# Also change the policy to allowlist only after review; approve one exact HTTPS provider:model|origin route.
# EXTERNAL_MODEL_ALLOWED_ROUTES='["groq:qwen/qwen3.8-27b|https://api.groq.com"]'
# GROQ_API_KEY=
# LLM7_API_KEY=
# KILO_API_KEY=
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=
